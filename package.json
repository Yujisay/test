  },
  "dependencies": {
    "axios": "^1.7.9",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.29",
    "esbuild": "^0.25.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
